__pycache__/
*.py[cod]
*.pyo

# 打包产物
dist/
build/
*.exe

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 成片与素材（体积大，不入库）
**/*.mp4
**/*.mov
**/*.wav
**/*.png
**/*.jpg

# 对比报告（含对第三方项目的逐项分析，留本地）
# 例外的写法：先排除整个目录，再用 ! 把要留的具体文件捞回来。
# 注意 git 的规矩——**目录被排除后，里面的文件拿不回来**，
# 所以要排除的是 `reports/*`（文件级），不是 `reports/`（目录级）。
reports/*
!reports/v*-检验报告.md

# 探针临时产物
_test/tmp/
# 探针的输出快照（每次跑都变，只留生成本身的结论）
_test/*_out.txt

# 断点续跑状态（含时间戳，每次跑都变；指纹是本地工作流用的，不入库）
.progress.json
